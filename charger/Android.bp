        "charger_battery_scale_vendor",
        "charger_percent_font_vendor",
    ],
    src: "values/charger/animation.txt",
    relative_install_path: "res/values/charger",
    proprietary: true,
}

phony {
    name: "noteng_charger",
    required: [
        "charger_animation",
        "charger_battery_0",
        "charger_battery_10",
        "charger_battery_20",
        "charger_battery_30",
        "charger_battery_40",
        "charger_battery_50",
        "charger_battery_60",
        "charger_battery_70",
        "charger_battery_80",
        "charger_battery_90",
        "charger_battery_100",
        "charger_battery_fail",
        "charger_battery_scale",
        "charger_percent_font",
    ],
}

phony {
    name: "noteng_charger_vendor",
    required: [
        "charger_animation_vendor",
        "charger_battery_0_vendor",
        "charger_battery_10_vendor",
